# ==============================================================================
# CoverCraft AI - Environment Configuration Template
# All keys below use placeholder values. Copy to .env.local (web) or .env (mcp).
# NEVER commit your actual API keys or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI & Search Engines (Core Functionality)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily AI Search API Key for real-time company research (Get from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 2. Authentication & Security (NextAuth.js)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_32_character_secret_here

# ------------------------------------------------------------------------------
# 3. Optional Evidence & Candidate Proofing Credentials
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Optional: Increases GitHub API rate limits for candidate project audits)
GITHUB_TOKEN=your_github_token_here

# Hugging Face Access Token (Optional: Verifies candidate ML models, spaces, and datasets)
HF_TOKEN=your_huggingface_token_here

# Jina AI Reader API Key (Optional: Deep markdown extraction for target company portals)
JINA_API_KEY=your_jina_api_key_here

# ------------------------------------------------------------------------------
# 4. Optional LLM Fallback & Telemetry Storage
# ------------------------------------------------------------------------------
# OpenRouter API Key (Optional: Secondary multi-model LLM provider fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB Atlas Connection URI (Optional: Telemetry, generation logs & audit trails)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=CoverCraft
MONGODB_DB_NAME=covercraft_db
