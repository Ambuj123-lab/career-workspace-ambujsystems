# ==============================================================================
# CoverCraft AI (Web Application) - Local Environment Template
# Copy this file to .env.local and populate with your own API keys.
# DO NOT commit .env.local to version control.
# ==============================================================================

# Core AI Synthesis (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Real-Time Web Intelligence & Company Research (Tavily AI: https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Session Encryption
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_32_character_secret_here

# Optional: GitHub API Token for Candidate Repository Proofing
GITHUB_TOKEN=your_github_token_here

# Optional: Hugging Face API Token for ML Artifact Proofing
HF_TOKEN=your_huggingface_token_here

# Optional: Jina AI Reader API Key for Target Company Deep Grounding
JINA_API_KEY=your_jina_api_key_here

# Optional: OpenRouter API Key for Multi-Provider LLM Fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: MongoDB Atlas Telemetry & Session Storage
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=CoverCraft
MONGODB_DB_NAME=covercraft_db
